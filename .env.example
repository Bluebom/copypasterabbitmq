# ---------------------------------------------------------------
# Conexão com o RabbitMQ de origem (produção)
# ---------------------------------------------------------------
ORIGEM_HOST=
ORIGEM_PORT=
ORIGEM_VHOST=
ORIGEM_USER=
ORIGEM_PASS=
ORIGEM_USE_SSL=

# ---------------------------------------------------------------
# Conexão com o RabbitMQ de destino (teste)
# ---------------------------------------------------------------
DESTINO_HOST=
DESTINO_PORT=
DESTINO_VHOST=
DESTINO_USER=
DESTINO_PASS=
DESTINO_USE_SSL=

# ---------------------------------------------------------------
# Lista de filas a copiar, separadas por vírgula.
# Deixe em branco para copiar TODAS as filas do vhost de origem
# (descoberta automática via API de gerenciamento).
# Exemplo: FILAS=fila1,fila2,fila3
# ---------------------------------------------------------------
FILAS=

# Quantidade de mensagens a copiar por fila
MENSAGENS_POR_FILA=

# Se true, devolve a mensagem original para a fila de origem
# (cópia não destrutiva). Se false, a mensagem é removida da origem.
PRESERVAR_ORIGEM=
